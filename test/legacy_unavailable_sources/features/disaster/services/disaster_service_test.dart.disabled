import 'dart:async';
import 'package:flutter_test/flutter_test.dart';
import 'package:mocktail/mocktail.dart';
import 'package:pakaiankita/features/disaster/services/disaster_service.dart';
import 'package:supabase_flutter/supabase_flutter.dart';

class MockSupabaseClient extends Mock implements SupabaseClient {}

class MockGoTrueClient extends Mock implements GoTrueClient {}

class MockUser extends Mock implements User {}

class MockSupabaseQueryBuilder extends Mock implements SupabaseQueryBuilder {}

class FakePostgrestFilterBuilder<T> extends Fake
    implements PostgrestFilterBuilder<T> {
  final Future<T> _future;
  final void Function(String column, Object value)? onLte;
  final void Function(String column, Object value)? onGt;

  FakePostgrestFilterBuilder(this._future, {this.onLte, this.onGt});

  @override
  Future<R> then<R>(FutureOr<R> Function(T value) onValue,
      {Function? onError}) {
    return _future.then(onValue, onError: onError);
  }

  @override
  Future<T> catchError(Function onError, {bool Function(Object error)? test}) {
    return _future.catchError(onError, test: test);
  }

  @override
  Future<T> whenComplete(FutureOr<void> Function() action) {
    return _future.whenComplete(action);
  }

  @override
  PostgrestFilterBuilder<T> eq(String column, Object value) => this;

  @override
  PostgrestFilterBuilder<T> lte(String column, Object value) {
    onLte?.call(column, value);
    return this;
  }

  @override
  PostgrestFilterBuilder<T> gt(String column, Object value) {
    onGt?.call(column, value);
    return this;
  }

  @override
  PostgrestFilterBuilder<T> not(
          String column, String operator, Object? value) =>
      this;

  @override
  PostgrestFilterBuilder<T> order(String column,
          {bool ascending = false,
          bool nullsFirst = false,
          String? referencedTable}) =>
      this;

  @override
  PostgrestTransformBuilder<List<Map<String, dynamic>>> select(
          [String columns = '*']) =>
      FakePostgrestTransformBuilder<List<Map<String, dynamic>>>(
          _future as dynamic);
}

class FakePostgrestTransformBuilder<T> extends Fake
    implements PostgrestTransformBuilder<T> {
  final Future<T> _future;
  FakePostgrestTransformBuilder(this._future);

  @override
  Future<R> then<R>(FutureOr<R> Function(T value) onValue,
      {Function? onError}) {
    return _future.then(onValue, onError: onError);
  }

  @override
  PostgrestTransformBuilder<Map<String, dynamic>> single() {
    final singleFuture = (_future as Future<List<Map<String, dynamic>>>)
        .then((list) => list.first);
    return FakePostgrestTransformBuilder<Map<String, dynamic>>(singleFuture);
  }
}

void main() {
  late MockSupabaseClient mockSupabase;
  late MockGoTrueClient mockAuth;
  late MockUser mockUser;
  late DisasterService disasterService;

  setUp(() {
    mockSupabase = MockSupabaseClient();
    mockAuth = MockGoTrueClient();
    mockUser = MockUser();
    when(() => mockSupabase.auth).thenReturn(mockAuth);
    when(() => mockAuth.currentUser).thenReturn(mockUser);
    when(() => mockUser.id).thenReturn('admin-uuid-1');
    disasterService = DisasterService(client: mockSupabase);
  });

  group('DisasterService', () {
    test('fetchActiveIncidents queries active incidents and parses results',
        () async {
      final mockQuery = MockSupabaseQueryBuilder();
      when(() => mockSupabase.from('incidents')).thenAnswer((_) => mockQuery);

      final fakeData = [
        {
          'id': 'incident-1',
          'organization_id': 'org-1',
          'title': 'Banjir Demak',
          'area': 'Jawa Tengah',
          'status': 'active',
          'starts_at': '2026-10-31T00:00:00Z',
          'ends_at': '2026-11-10T00:00:00Z',
          'approved_by': 'admin-uuid-1',
          'organizations': {'name': 'BPBD'},
        }
      ];

      final builder = FakePostgrestFilterBuilder<List<Map<String, dynamic>>>(
        Future.value(fakeData),
      );
      when(() => mockQuery.select(any())).thenAnswer((_) => builder);

      final list = await disasterService.fetchActiveIncidents();

      expect(list.length, 1);
      expect(list.first.id, 'incident-1');
      expect(list.first.title, 'Banjir Demak');
      expect(list.first.isActive, isTrue);
    });

    test('fetchActiveIncidents queries using UTC timestamps ending in Z',
        () async {
      final mockQuery = MockSupabaseQueryBuilder();
      when(() => mockSupabase.from('incidents')).thenAnswer((_) => mockQuery);

      String? lteVal;
      String? gtVal;

      final builder = FakePostgrestFilterBuilder<List<Map<String, dynamic>>>(
        Future.value([]),
        onLte: (col, val) {
          if (col == 'starts_at') lteVal = val.toString();
        },
        onGt: (col, val) {
          if (col == 'ends_at') gtVal = val.toString();
        },
      );
      when(() => mockQuery.select(any())).thenAnswer((_) => builder);

      await disasterService.fetchActiveIncidents();

      expect(lteVal, isNotNull);
      expect(lteVal!.endsWith('Z'), isTrue);
      expect(gtVal, isNotNull);
      expect(gtVal!.endsWith('Z'), isTrue);
    });

    test('requestDisasterDeclaration inserts incident row and returns id',
        () async {
      final mockQuery = MockSupabaseQueryBuilder();
      when(() => mockSupabase.from('incidents')).thenAnswer((_) => mockQuery);

      final fakeFilter = FakePostgrestFilterBuilder<List<Map<String, dynamic>>>(
        Future.value([
          {'id': 'created-incident-uuid'}
        ]),
      );
      when(() => mockQuery.insert(any())).thenAnswer((_) => fakeFilter);

      final id = await disasterService.requestDisasterDeclaration(
        organizationId: 'org-posko-1',
        title: 'Longsor Wonosobo',
        area: 'Jawa Tengah',
        startsAt: DateTime.parse('2026-10-31T00:00:00Z'),
        endsAt: DateTime.parse('2026-11-05T00:00:00Z'),
      );

      expect(id, 'created-incident-uuid');
    });

    test('requestDisasterDeclaration formats startsAt and endsAt in UTC format',
        () async {
      final mockQuery = MockSupabaseQueryBuilder();
      when(() => mockSupabase.from('incidents')).thenAnswer((_) => mockQuery);

      Map<String, dynamic>? capturedInsert;
      final fakeFilter = FakePostgrestFilterBuilder<List<Map<String, dynamic>>>(
        Future.value([
          {'id': 'created-incident-uuid'}
        ]),
      );
      when(() => mockQuery.insert(any())).thenAnswer((invocation) {
        capturedInsert =
            invocation.positionalArguments.first as Map<String, dynamic>;
        return fakeFilter;
      });

      final localStart = DateTime(2026, 10, 31, 7, 0, 0);
      final localEnd = DateTime(2026, 11, 5, 7, 0, 0);

      await disasterService.requestDisasterDeclaration(
        organizationId: 'org-posko-1',
        title: 'Longsor Wonosobo',
        area: 'Jawa Tengah',
        startsAt: localStart,
        endsAt: localEnd,
      );

      expect(capturedInsert, isNotNull);
      expect((capturedInsert!['starts_at'] as String).endsWith('Z'), isTrue);
      expect((capturedInsert!['ends_at'] as String).endsWith('Z'), isTrue);
    });

    test('approveDisaster updates status to active with approved_by', () async {
      final mockQuery = MockSupabaseQueryBuilder();
      when(() => mockSupabase.from('incidents')).thenAnswer((_) => mockQuery);

      final builder = FakePostgrestFilterBuilder<dynamic>(Future.value(null));
      when(() => mockQuery.update(any())).thenAnswer((_) => builder);

      await disasterService.approveDisaster(incidentId: 'incident-1');

      verify(() => mockQuery.update({
            'status': 'active',
            'approved_by': 'admin-uuid-1',
          })).called(1);
    });

    test('closeDisaster updates status to closed', () async {
      final mockQuery = MockSupabaseQueryBuilder();
      when(() => mockSupabase.from('incidents')).thenAnswer((_) => mockQuery);

      final builder = FakePostgrestFilterBuilder<dynamic>(Future.value(null));
      when(() => mockQuery.update(any())).thenAnswer((_) => builder);

      await disasterService.closeDisaster(incidentId: 'incident-1');

      verify(() => mockQuery.update({
            'status': 'closed',
          })).called(1);
    });

    test('findPreCuratedStockForEmergency finds and sorts available matches',
        () async {
      final mockQuery = MockSupabaseQueryBuilder();
      when(() => mockSupabase.from('inventory_batches'))
          .thenAnswer((_) => mockQuery);

      final fakeBatches = [
        {
          'id': 'batch-a',
          'point_id': 'point-1',
          'category': 'kaos',
          'size_code': 'M',
          'age_group': 'anak',
          'initial_qty': 10,
          'on_hand_qty': 8,
          'reserved_qty': 3, // available 5
          'collection_points': {
            'name': 'Posko Kudus',
            'public_address': 'Jl. Kudus 1'
          },
        },
        {
          'id': 'batch-b',
          'point_id': 'point-2',
          'category': 'kaos',
          'size_code': 'M',
          'age_group': 'anak',
          'initial_qty': 15,
          'on_hand_qty': 12,
          'reserved_qty': 0, // available 12
          'collection_points': {
            'name': 'Gudang Semarang',
            'public_address': 'Jl. Pandanaran 2'
          },
        },
      ];

      final builder = FakePostgrestFilterBuilder<List<Map<String, dynamic>>>(
        Future.value(fakeBatches),
      );
      when(() => mockQuery.select(any())).thenAnswer((_) => builder);

      final matches = await disasterService.findPreCuratedStockForEmergency(
        category: 'kaos',
        sizeCode: 'M',
        ageGroup: 'anak',
        requestedQty: 10,
      );

      expect(matches.length, 2);
      // Sorted by largest available first: batch-b (12) then batch-a (5)
      expect(matches.first.batchId, 'batch-b');
      expect(matches.first.availableQty, 12);
      expect(matches.first.matchedQty, 10);
      expect(matches.first.isFullMatch, isTrue);

      expect(matches.last.batchId, 'batch-a');
      expect(matches.last.availableQty, 5);
      expect(matches.last.matchedQty, 5);
      expect(matches.last.isFullMatch, isFalse);
    });
  });
}
