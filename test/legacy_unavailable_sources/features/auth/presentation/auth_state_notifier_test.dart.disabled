import 'dart:async';
import 'package:flutter_test/flutter_test.dart';
import 'package:mocktail/mocktail.dart';
import 'package:pakaiankita/core/models/app_role.dart';
import 'package:pakaiankita/core/models/user_access.dart';
import 'package:pakaiankita/features/auth/presentation/auth_state_notifier.dart';
import 'package:pakaiankita/features/auth/services/auth_service.dart';
import 'package:supabase_flutter/supabase_flutter.dart';

class MockAuthService extends Mock implements IAuthService {}

class MockUser extends Mock implements User {}

class MockSession extends Mock implements Session {}

class MockAuthResponse extends Mock implements AuthResponse {}

void main() {
  late MockAuthService mockAuthService;
  late AuthStateNotifier notifier;

  setUp(() {
    mockAuthService = MockAuthService();
    when(() => mockAuthService.authStateChanges).thenAnswer((_) => const Stream.empty());
    notifier = AuthStateNotifier(authService: mockAuthService);
  });

  group('AuthStateNotifier', () {
    test('initial state is unauthenticated and not loading', () {
      expect(notifier.isLoading, isFalse);
      expect(notifier.errorMessage, isNull);
      expect(notifier.currentUser, isNull);
      expect(notifier.isAuthenticated, isFalse);
      expect(notifier.currentAccess.roles, isEmpty);
      expect(notifier.currentAccess.ui, AppUiShell.user);
    });

    test('initialize loads user and access if already logged in', () async {
      final mockUser = MockUser();
      when(() => mockAuthService.currentUser).thenReturn(mockUser);
      when(() => mockAuthService.fetchAccess()).thenAnswer(
        (_) async => const UserAccess(
          roles: [AppRole.donatur],
          ui: AppUiShell.user,
        ),
      );

      await notifier.initialize();

      expect(notifier.isLoading, isFalse);
      expect(notifier.currentUser, mockUser);
      expect(notifier.isAuthenticated, isTrue);
      expect(notifier.currentAccess.roles, [AppRole.donatur]);
    });

    test('signIn succeeds and updates access', () async {
      final mockUser = MockUser();
      final mockResponse = MockAuthResponse();
      when(() => mockResponse.user).thenReturn(mockUser);
      when(() => mockAuthService.signIn(email: 'user@test.com', password: '123'))
          .thenAnswer((_) async => mockResponse);
      when(() => mockAuthService.currentUser).thenReturn(mockUser);
      when(() => mockAuthService.fetchAccess()).thenAnswer(
        (_) async => const UserAccess(
          roles: [AppRole.donatur],
          ui: AppUiShell.user,
        ),
      );

      final success = await notifier.signIn('user@test.com', '123');

      expect(success, isTrue);
      expect(notifier.isLoading, isFalse);
      expect(notifier.currentUser, mockUser);
      expect(notifier.currentAccess.roles, [AppRole.donatur]);
      expect(notifier.errorMessage, isNull);
    });

    test('signIn sets errorMessage on failure', () async {
      when(() => mockAuthService.signIn(email: 'user@test.com', password: 'wrong'))
          .thenThrow(const AuthException('Invalid login credentials'));

      final success = await notifier.signIn('user@test.com', 'wrong');

      expect(success, isFalse);
      expect(notifier.isLoading, isFalse);
      expect(notifier.errorMessage, 'Invalid login credentials');
      expect(notifier.isAuthenticated, isFalse);
    });

    test('signOut clears user and resets access', () async {
      when(() => mockAuthService.signOut()).thenAnswer((_) async {});

      await notifier.signOut();

      expect(notifier.currentUser, isNull);
      expect(notifier.isAuthenticated, isFalse);
      expect(notifier.currentAccess.roles, isEmpty);
      expect(notifier.isAwaitingEmailConfirmation, isFalse);
    });

    test('signUp with session == null marks isAwaitingEmailConfirmation and does not fetch access', () async {
      final mockUser = MockUser();
      final mockResponse = MockAuthResponse();
      when(() => mockResponse.user).thenReturn(mockUser);
      when(() => mockResponse.session).thenReturn(null);
      when(() => mockAuthService.signUp(
            email: 'new@test.com',
            password: 'password123',
            fullName: any(named: 'fullName'),
            displayName: any(named: 'displayName'),
          )).thenAnswer((_) async => mockResponse);

      final success = await notifier.signUp('new@test.com', 'password123', fullName: 'New User');

      expect(success, isTrue);
      expect(notifier.isAwaitingEmailConfirmation, isTrue);
      expect(notifier.isAuthenticated, isFalse);
      expect(notifier.currentAccess.roles, isEmpty);
      verifyNever(() => mockAuthService.fetchAccess());
    });

    test('signUp with active session marks authenticated and loads access', () async {
      final mockUser = MockUser();
      final mockSession = MockSession();
      final mockResponse = MockAuthResponse();
      when(() => mockResponse.user).thenReturn(mockUser);
      when(() => mockResponse.session).thenReturn(mockSession);
      when(() => mockAuthService.signUp(
            email: 'new@test.com',
            password: 'password123',
            fullName: any(named: 'fullName'),
            displayName: any(named: 'displayName'),
          )).thenAnswer((_) async => mockResponse);
      when(() => mockAuthService.currentUser).thenReturn(mockUser);
      when(() => mockAuthService.fetchAccess()).thenAnswer(
        (_) async => const UserAccess(roles: [AppRole.donatur], ui: AppUiShell.user),
      );

      final success = await notifier.signUp('new@test.com', 'password123', fullName: 'New User');

      expect(success, isTrue);
      expect(notifier.isAwaitingEmailConfirmation, isFalse);
      expect(notifier.isAuthenticated, isTrue);
      expect(notifier.currentAccess.roles, [AppRole.donatur]);
      verify(() => mockAuthService.fetchAccess()).called(1);
    });

    test('handles authStateChanges signedOut event by clearing user and access', () async {
      final streamController = StreamController<AuthState>();
      when(() => mockAuthService.authStateChanges).thenAnswer((_) => streamController.stream);

      final customNotifier = AuthStateNotifier(authService: mockAuthService);
      streamController.add(AuthState(AuthChangeEvent.signedOut, null));
      await Future.delayed(Duration.zero);

      expect(customNotifier.currentUser, isNull);
      expect(customNotifier.isAuthenticated, isFalse);
      expect(customNotifier.currentAccess.roles, isEmpty);
      customNotifier.dispose();
      await streamController.close();
    });

    test('handles authStateChanges signedIn event by refreshing access', () async {
      final streamController = StreamController<AuthState>();
      when(() => mockAuthService.authStateChanges).thenAnswer((_) => streamController.stream);
      final mockUser = MockUser();
      final mockSession = MockSession();
      when(() => mockSession.user).thenReturn(mockUser);
      when(() => mockAuthService.fetchAccess()).thenAnswer(
        (_) async => const UserAccess(roles: [AppRole.relawan], ui: AppUiShell.user),
      );

      final customNotifier = AuthStateNotifier(authService: mockAuthService);
      streamController.add(AuthState(AuthChangeEvent.signedIn, mockSession));
      await Future.delayed(Duration.zero);

      expect(customNotifier.currentUser, mockUser);
      expect(customNotifier.currentAccess.roles, [AppRole.relawan]);
      customNotifier.dispose();
      await streamController.close();
    });

    test('guards against auth race condition where signedIn completes after signedOut', () async {
      final streamController = StreamController<AuthState>();
      when(() => mockAuthService.authStateChanges).thenAnswer((_) => streamController.stream);

      final mockUser = MockUser();
      when(() => mockUser.id).thenReturn('user-1');
      final mockSession = MockSession();
      when(() => mockSession.user).thenReturn(mockUser);

      final fetchCompleter = Completer<UserAccess>();
      when(() => mockAuthService.fetchAccess()).thenAnswer((_) => fetchCompleter.future);

      final customNotifier = AuthStateNotifier(authService: mockAuthService);

      // User signs in (slow network for fetchAccess)
      streamController.add(AuthState(AuthChangeEvent.signedIn, mockSession));
      await Future.delayed(Duration.zero);

      // User immediately signs out
      streamController.add(AuthState(AuthChangeEvent.signedOut, null));
      await Future.delayed(Duration.zero);

      // Now fetchAccess finishes late
      fetchCompleter.complete(const UserAccess(roles: [AppRole.admin], ui: AppUiShell.admin));
      await Future.delayed(Duration.zero);

      // State must remain unauthenticated with empty roles, NOT overwritten by delayed admin role
      expect(customNotifier.currentUser, isNull);
      expect(customNotifier.isAuthenticated, isFalse);
      expect(customNotifier.currentAccess.roles, isEmpty);

      customNotifier.dispose();
      await streamController.close();
    });
  });
}
